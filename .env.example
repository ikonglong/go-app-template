# Copy to .env and fill in. These are placeholders / sane defaults; real
# environment variables injected by the platform (systemd / Docker / K8s)
# override anything here — see internal/assembly/config.go. Never commit a
# real .env (it is gitignored).

# Server
SERVER__HOST=0.0.0.0
SERVER__PORT=8080

# Logging
# Format: text (local dev — logfmt, nested groups as dotted keys like
#         req.method) | json (deploy/prod — nested objects)
LOG__FORMAT=text
LOG__LEVEL=debug
# Destinations (comma-separated): console, file, or "console,file"
LOG__OUTPUT=console
# File destination — used only when LOG__OUTPUT includes "file". Rolling is
# handled in-process by lumberjack; tune the knobs below.
#LOG__FILE_PATH=logs/app.log
#LOG__FILE_MAX_SIZE_MB=100
#LOG__FILE_MAX_BACKUPS=7
#LOG__FILE_MAX_AGE_DAYS=30
#LOG__FILE_COMPRESS=false

# Database
DATABASE__HOST=localhost
DATABASE__PORT=5432
DATABASE__NAME=app
DATABASE__USER=
DATABASE__PASSWORD=

# scaffold:begin
# Repo — persistence implementation: jet (default) | sqlc
REPO__IMPL=jet
# scaffold:end
